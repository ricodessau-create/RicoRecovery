<Application x:Class="RicoRecovery.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1F22" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2D31" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F3F5" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5BAC1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    </Application.Resources>
</Application>
