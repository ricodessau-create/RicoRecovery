<Window x:Class="RicoRecovery.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RicoRecovery.App.ViewModels"
        Title="RicoRecovery"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding ProductName}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding Tagline}"
                       Margin="0,4,0,0"
                       FontSize="16"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Text="{Binding VersionText}"
                       Margin="0,2,0,0"
                       FontSize="12"
                       Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Margin="0,32,0,8"
                   Text="Sicherheitsprinzipien"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}" />
        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="6"
                Background="{StaticResource PanelBackgroundBrush}">
            <ItemsControl ItemsSource="{Binding SafetyPrinciples}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Margin="0,0,0,10"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
